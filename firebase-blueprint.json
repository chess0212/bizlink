{
  "entities": {
    "User": {
      "title": "User",
      "description": "Information about a seller",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "role": { "type": "string", "enum": ["seller", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role"]
    },
    "Shop": {
      "title": "Shop",
      "description": "Details of a seller's shop",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "logo": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "orangeMoney": { "type": "string" },
        "mtnMoney": { "type": "string" },
        "moovMoney": { "type": "string" },
        "deliveryZones": { "type": "array", "items": { "type": "string" } },
        "currency": { "type": "string", "enum": ["XOF"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "whatsappNumber"]
    },
    "Product": {
      "title": "Product",
      "description": "A product listed in a shop",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "stock": { "type": "integer" },
        "variants": { "type": "object" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["shopId", "name", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "delivering", "completed", "cancelled"] },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "pending", "paid"] },
        "deliveryAddress": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["shopId", "customerPhone", "items", "total"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Root user profiles"
    },
    "/shops/{shopId}": {
      "schema": "Shop",
      "description": "Boutiques with their configurations"
    },
    "/shops/{shopId}/products/{productId}": {
      "schema": "Product",
      "description": "Products within a specific boutique"
    },
    "/shops/{shopId}/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders placed at a specific boutique"
    }
  }
}
